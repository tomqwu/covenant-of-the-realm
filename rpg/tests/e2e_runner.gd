	_expect(game.get_node("%ObjectiveLabel").text.contains("崩石重击") and game.get_node("%ObjectiveLabel").text.contains("破绽窗口　守势调息"), "E2E 首领重击回合显示正确守势窗口")
	await _press_action(game, "守势调息")
